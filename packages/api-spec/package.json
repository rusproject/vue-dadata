{
  "name": "@dadata-sdk/api-spec",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Bundled OpenAPI and JSON Schema artifacts for the DaData API.",
  "keywords": [
    "dadata",
    "openapi",
    "json-schema",
    "schema",
    "api"
  ],
  "homepage": "https://alexchexes.github.io/dadata-sdk/en/spec",
  "bugs": {
    "url": "https://github.com/alexchexes/dadata-sdk/issues"
  },
  "author": "Alex Chexes <alexchexes@gmail.com>",
  "license": "MIT",
  "files": [
    "dadata.json",
    "dadata.yaml",
    "schemas/request.json",
    "schemas/response.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alexchexes/dadata-sdk",
    "directory": "packages/api-spec"
  },
  "scripts": {
    "build": "pnpm run gen:artifacts",
    "test": "node --import tsx --test ./scripts/official-comparison/*.test.ts ./scripts/official-comparison/operations/*.test.ts ./scripts/official-comparison/normalization/*.test.ts ./scripts/official-comparison/diff/*.test.ts",
    "type-check": "tsc -p tsconfig.scripts.json --noEmit",
    "gen:schemas": "pnpm exec schema-gen --input ../api-types/schema-types --output ./schemas",
    "gen:bundle": "pnpm exec tsx ./scripts/bundle-openapi.ts ./source/dadata-src.yaml ./dadata.json ./dadata.yaml",
    "gen:artifacts": "pnpm run gen:schemas && pnpm run gen:bundle",
    "official": "pnpm exec tsx ./scripts/official.ts"
  },
  "devDependencies": {
    "@dadata-sdk/schema-gen": "workspace:*",
    "@redocly/cli": "^2.0.2",
    "@scalar/openapi-types": "^0.3.7",
    "@types/node": "^24.1.0",
    "prettier": "^3.6.2",
    "tar": "7.5.22",
    "tsx": "^4.19.4",
    "yaml": "^2.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
